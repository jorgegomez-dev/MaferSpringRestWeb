}



class Usuario {
    - private Long id;
    - private String nombre;
    - private String apellido;
    - private String email;
    - private String telefono;
    - private String username;
    - private String password;
    - private String role;
    - private Double peso;
    - private Double altura;
    - private Double imc;
    - private String sexo;
