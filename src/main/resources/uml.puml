    - private LocalDate fechaInicioAsesoria;
    - private LocalDate fechaFinAsesoria;
    - private boolean Authenticated = false;
    - private Integer session;

    + getters()
    + setters()
    }

class Asesoria {

    - private Long id;
    - private String nombreAsesoria;
    - private String tipoAsesoria;
